              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Nuevo\",\n  \"apellidos\": \"Usuario Modificado\",\n  \"correo\": \"nuevo@pmap.com\",\n  \"contraseña\": \"\",\n  \"rol\": \"ADMINISTRADOR\",\n  \"estado\": \"ACTIVO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/usuarios/{{id_usuario}}",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "{{id_usuario}}"]
            }
          }
        },
        {
          "name": "Activar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/{{id_usuario}}/activate",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "{{id_usuario}}", "activate"]
            }
          }
        },
        {
          "name": "Desactivar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/{{id_usuario}}/deactivate",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "{{id_usuario}}", "deactivate"]
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/{{id_usuario}}",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "{{id_usuario}}"]
            }
          }
        }
      ]
    },
