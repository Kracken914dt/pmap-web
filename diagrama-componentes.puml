@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam monochrome false
skinparam shadowing false

skinparam package {
  BorderColor #2E4057
  FontColor #2E4057
  BackgroundColor #F0F4F8
}

skinparam component {
  BorderColor #3A6EA5
  FontColor #1A1A2E
  BackgroundColor #D6E4F0
  RoundCorner 6
}

skinparam rectangle {
  BorderColor #2E4057
  FontColor #FFFFFF
  BackgroundColor #2E4057
  RoundCorner 8
}

skinparam database {
  BorderColor #2D6A4F
  FontColor #FFFFFF
  BackgroundColor #2D6A4F
}

skinparam arrow {
  Color #555555
  FontColor #555555
}

skinparam note {
  BackgroundColor #FFF3CD
  BorderColor #FFC107
}

' ============================================================
' DIAGRAMA DE COMPONENTES
' ============================================================

title Diagrama de Componentes - PMAP

package "Frontend (React + Vite)" as front_pkg {
  rectangle "main.jsx\n(Entry Point)" as main_entry
  rectangle "App.jsx\n(Root)" as app_root
  rectangle "AppRouter.jsx\n(Routes)" as router

  package "api" as api_pkg {
    component "http.js\n(Axios Instance)" as http
    note right of http
      baseURL: localhost:8080/api
      JWT Interceptor
    end note
  }

  package "services" as svc_pkg {
    component "authService.js" as auth_svc_f
  }

  package "utils" as util_pkg {
    component "storage.js\n(localStorage)" as storage
  }

  package "hooks" as hook_pkg {
    component "useAuth.js" as use_auth
  }

  package "layouts" as layout_pkg {
    component "MainLayout.jsx" as main_layout
  }

  package "routes" as route_pkg {
    component "ProtectedRoute.jsx\n(Auth Guard)" as guard
  }

  package "pages" as page_pkg {
    component "LoginPage.jsx" as login_page
    component "DashboardPage.jsx" as dash_page
    component "UsuariosPage.jsx" as users_page
    component "MateriasPage.jsx" as mats_page
    component "SesionesPage.jsx" as sesis_page
    component "PerfilPage.jsx" as profile_page
    component "NotFoundPage.jsx" as notfound
  }

  package "components (UI)" as ui_pkg {
    component "Navbar.jsx" as navbar
    component "Sidebar.jsx" as sidebar
    component "Footer.jsx" as footer
    component "Table.jsx" as table
    component "SearchBar.jsx" as search
    component "Pagination.jsx" as pagination
    component "Modal.jsx" as modal
    component "Form.jsx" as form
    component "Loader.jsx" as loader
    component "Spinner.jsx" as spinner
  }
}

package "Backend (Spring Boot 3.3.5)" as back_pkg {

  package "controller (REST)" as ctrl_pkg {
    component "AuthController" as auth_ctrl_b
    component "UsuarioController" as user_ctrl_b
    component "MateriaController" as mat_ctrl_b
    component "SesionEstudioController" as ses_ctrl_b
  }

  package "dto (Records)" as dto_pkg {
    component "LoginRequest / RegisterRequest\nAuthResponse" as auth_dto
    component "UsuarioCreateRequest / Update\nUsuarioResponse" as user_dto
    component "MateriaCreateRequest / Update\nMateriaResponse" as mat_dto
    component "SesionEstudioCreateRequest / Update\nSesionEstudioResponse" as ses_dto
  }

  package "service (Interface + Impl)" as svc_pkg_b {
    component "AuthService / AuthServiceImpl" as auth_svc_b
    component "UsuarioService / UsuarioServiceImpl" as user_svc_b
    component "MateriaService / MateriaServiceImpl" as mat_svc_b
    component "SesionEstudioService / SesionEstudioServiceImpl" as ses_svc_b
  }

  package "repository (JPA)" as repo_pkg {
    component "UsuarioRepository" as user_repo_b
    component "MateriaRepository" as mat_repo_b
    component "SesionEstudioRepository" as ses_repo_b
  }

  package "entity (JPA)" as ent_pkg {
    component "Usuario" as user_ent
    component "Materia" as mat_ent
    component "SesionEstudio" as ses_ent
  }

  package "mapper" as map_pkg {
    component "UsuarioMapper" as user_map_b
    component "MateriaMapper" as mat_map_b
    component "SesionEstudioMapper" as ses_map_b
  }

  package "security" as sec_pkg_b {
    component "SecurityConfig" as sec_conf
    component "JwtService" as jwt_svc_b
    component "JwtAuthenticationFilter" as jwt_filter_b
    component "CustomUserDetailsService" as user_dets
  }

  package "exception" as exc_pkg {
    component "GlobalExceptionHandler" as exc_handler_b
    component "ResourceNotFoundException" as exc_notfound
    component "DuplicateResourceException" as exc_dup
    component "ApiError (record)" as api_error
  }

  package "config" as cfg_pkg {
    component "OpenApiConfig / Swagger" as swagger_b
    component "DataSeeder\n(10 users, 10 subjects)" as seeder_b
  }
}

database "PostgreSQL\npmap_db" as db_b {
  rectangle "usuarios\n(id, nombres, apellidos, correo,\ncontraseña, rol, estado, fecha_registro)" as tbl_user
  rectangle "materias\n(id, nombre, descripcion,\ncategoria, estado, fecha_creacion)" as tbl_mat
  rectangle "sesiones_estudio\n(id, usuario_id FK, materia_id FK,\nfecha, hora_inicio, hora_fin,\nobjetivo, estado)" as tbl_ses
}

